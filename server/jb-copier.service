[Unit]
Description=JB Copier relay server (MT5 copy trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copier
Group=copier
WorkingDirectory=/opt/jb_copier/server
# Plain HTTP on 8787. For HTTPS append: --cert /etc/letsencrypt/live/<domain>/fullchain.pem --key /etc/letsencrypt/live/<domain>/privkey.pem
ExecStart=/usr/bin/python3 /opt/jb_copier/server/copy_server.py --host 0.0.0.0 --port 8787 --config /opt/jb_copier/server/copy_server.json --log /opt/jb_copier/server/copy_server.log
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/jb_copier/server

[Install]
WantedBy=multi-user.target
